# GEMINI_API_KEY: Optional - enables AI proposal and product description drafting
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted
APP_URL="MY_APP_URL"

# APP_SECRET: Key used to sign session auth tokens
APP_SECRET="your-secure-random-secret-key-min-32-chars"

# (Optional) External Supabase PostgreSQL integration
SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_ANON_KEY="your-anon-public-key"
